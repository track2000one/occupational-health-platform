// ─── html2pdf options ─────────────────────────────────────────────────────────
function pdfOptions(filename: string, landscape = false) {
  return {
    margin: 0,
    filename,
    image: { type: 'jpeg', quality: 0.99 },
    html2canvas: {
      scale: 3,
      useCORS: true,
      letterRendering: true,
      logging: false,
      imageTimeout: 0,
      allowTaint: false,
      backgroundColor: '#ffffff'
    },
    jsPDF: {
      unit: 'mm',
      format: 'a4',
      orientation: landscape ? 'landscape' : 'portrait',
      compress: true
    },
    pagebreak: { mode: ['avoid-all', 'css', 'legacy'], after: '.page-break' },
  };
}

// ─── Shared HTML builders ─────────────────────────────────────────────────────
function htmlHeader(title: string, subtitle: string, _logoDataUrl: string) {
  return `
    <div class="report-header">
      <div class="header-content">
        <div class="header-logo-section">
          <div class="system-name">OCCUPATIONAL HEALTH MANAGEMENT SYSTEM</div>
          <div class="system-name-ar">نظام إدارة الصحة المهنية</div>
        </div>
        <div class="subtitle">Ministry of Health - Kingdom of Saudi Arabia</div>
        <div class="subtitle-ar">وزارة الصحة - المملكة العربية السعودية</div>
        <div class="report-title">${title}</div>
        <div class="subtitle" style="margin-top: 12px; font-size: 12px; opacity: 0.95;">${subtitle}</div>
      </div>
    </div>`;
}

function htmlMeta(cells: { label: string; value: string }[]) {
  return `
    <div class="meta-section clearfix">
      ${cells.map(c => `
        <div class="meta-item">
          <div class="meta-label">${c.label}</div>
          <div class="meta-value">${c.value}</div>
        </div>`).join('')}
    </div>`;
}

function htmlKpi(items: { label: string; value: string; color: string }[]) {
  return `
    <div class="kpi-section clearfix">
      ${items.map(k => `
        <div class="kpi-box" style="background: ${k.color};">
          <div class="kpi-value">${k.value}</div>
          <div class="kpi-label">${k.label}</div>
        </div>`).join('')}
    </div>`;
}

function htmlSection(title: string) {
  return `
    <div class="section-heading">
      <div class="section-title">${title}</div>
    </div>`;
}

function htmlFooter() {
  const now = new Date();
  const dateEn = now.toLocaleString('en-US', {
    dateStyle: 'long',
    timeStyle: 'short',
    hour12: true
  });
  const dateAr = now.toLocaleDateString('ar-SA', {
    dateStyle: 'long'
  });
  return `
    <div class="report-footer">
      <div class="footer-date">
        Generated: ${dateEn}
      </div>
      <div class="footer-date-ar">
        تاريخ الإنشاء: ${dateAr}
      </div>
      <div class="footer-confidential">
        <div class="footer-warning">⚠️ CONFIDENTIAL DOCUMENT</div>
        <div class="footer-text">
          This document contains sensitive health information protected by privacy regulations.<br/>
          Unauthorized disclosure or distribution is strictly prohibited.
        </div>
        <div class="footer-text-ar">
          هذا المستند يحتوي على معلومات صحية حساسة محمية بموجب لوائح الخصوصية<br/>
          يُحظر الإفصاح أو التوزيع غير المصرح به
        </div>
      </div>
    </div>`;
}

function wrapHtml(body: string) {
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <style>${BASE_CSS}</style>
</head>
<body>
  <div class="page-content">${body}</div>
</body>
</html>`;
}

// ─── Employee Directory ───────────────────────────────────────────────────────
export interface EmployeeRow {
  mohId: string;
  name: string;
  nationalId: string;
  jobTitle: string;
  healthCenter: string;
  gender: string;
  maritalStatus: string;
  dateOfStart: string;
}

export async function exportEmployeesPdf(rows: EmployeeRow[], _isRtl = false) {
  try {
    const logoBase64 = await getLogoBase64();
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-US', { dateStyle: 'long' });

  const tableRows = rows.map((r, idx) => `
    <tr>
      <td style="font-weight: 700; color: #1e40af;">${r.mohId || '—'}</td>
      <td style="text-align: left; font-weight: 600;">${r.name}</td>
      <td style="font-family: Courier, monospace; color: #64748b;">${r.nationalId}</td>
      <td style="text-align: left;">${r.jobTitle}</td>
      <td style="text-align: left;">${r.healthCenter}</td>
      <td>${r.gender.charAt(0).toUpperCase() + r.gender.slice(1)}</td>
      <td>${r.maritalStatus.charAt(0).toUpperCase() + r.maritalStatus.slice(1)}</td>
      <td style="color: #64748b;">${r.dateOfStart || '—'}</td>
    </tr>`).join('');

  const male = rows.filter(r => r.gender === 'male').length;
  const female = rows.filter(r => r.gender === 'female').length;
  const married = rows.filter(r => r.maritalStatus === 'married').length;

  const html = wrapHtml(`
    ${htmlHeader('Employee Directory', 'Confidential HR Record', logoBase64)}
    ${htmlMeta([
      { label: 'Report Date', value: dateStr },
      { label: 'Total Records', value: String(rows.length) },
      { label: 'Generated By', value: 'Occupational Health System' },
      { label: 'Classification', value: 'CONFIDENTIAL' },
    ])}
    ${htmlSection('Complete Employee Directory Listing')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>MOH ID</th>
            <th>Employee Name</th>
            <th>National ID</th>
            <th>Position</th>
            <th>Health Center</th>
            <th>Gender</th>
            <th>Status</th>
            <th>Start Date</th>
          </tr>
        </thead>
        <tbody>${tableRows}</tbody>
      </table>
    </div>
    ${htmlKpi([
      { label: 'Total Employees', value: String(rows.length), color: '#1e40af' },
      { label: 'Male', value: String(male), color: '#0891b2' },
      { label: 'Female', value: String(female), color: '#7c3aed' },
      { label: 'Married', value: String(married), color: '#16a34a' },
    ])}
    ${htmlFooter()}
  `);

    const filename = `Employee_Directory_${now.toISOString().slice(0, 10)}.pdf`;
    await html2pdf().set(pdfOptions(filename, true)).from(html).save();
  } catch (error) {
    console.error('Error generating Employee Directory PDF:', error);
    throw error;
  }
}

// ─── Periodic Examination Report ─────────────────────────────────────────────
export async function exportPeriodicExaminationPdf(
  coverageByCenter: { center: string; target: number; examined: number; percentage: number }[],
) {
  try {
    const logoBase64 = await getLogoBase64();
    const now = new Date();
    const totalTarget   = coverageByCenter.reduce((s, r) => s + r.target, 0);
    const totalExamined = coverageByCenter.reduce((s, r) => s + r.examined, 0);
    const overallPct    = Math.round((totalExamined / totalTarget) * 100);

  const tableRows = coverageByCenter.map(r => `
    <tr>
      <td style="text-align: left; font-weight: 600;">${r.center}</td>
      <td style="font-weight: 700; color: #1e40af;">${r.target}</td>
      <td style="font-weight: 700; color: #16a34a;">${r.examined}</td>
      <td style="font-weight: 700; color: #dc2626;">${r.target - r.examined}</td>
      <td style="font-weight: 900; font-size: 11px; color: ${r.percentage >= 80 ? '#16a34a' : '#dc2626'};">${r.percentage}%</td>
      <td>
        <span class="status-badge ${r.percentage >= 80 ? 'status-on-track' : 'status-attention'}">
          ${r.percentage >= 80 ? '✓ On Track' : '⚠ Attention'}
        </span>
      </td>
    </tr>`).join('');

  const obs = [
    `Overall examination coverage stands at ${overallPct}%, which is ${overallPct >= 80 ? 'within' : 'below'} the 80% target threshold.`,
    `${coverageByCenter.filter(r => r.percentage >= 80).length} out of ${coverageByCenter.length} centers have achieved the target coverage rate.`,
    'Centers below target should schedule catch-up examination sessions before the fiscal year end.',
    'Recommend increasing outreach efforts for centers with coverage below 75%.',
  ];

  const html = wrapHtml(`
    ${htmlHeader('Annual Periodic Examination Report', 'Health Screening Coverage Analysis', logoBase64)}
    ${htmlMeta([
      { label: 'Report Date', value: now.toLocaleDateString('en-US', { dateStyle: 'long' }) },
      { label: 'Reporting Period', value: `Fiscal Year ${now.getFullYear()}` },
      { label: 'Health Centers', value: String(coverageByCenter.length) },
      { label: 'Target Achievement', value: `${overallPct}%` },
    ])}
    ${htmlKpi([
      { label: 'Target Employees', value: String(totalTarget), color: '#1e40af' },
      { label: 'Examined', value: String(totalExamined), color: '#16a34a' },
      { label: 'Remaining', value: String(totalTarget - totalExamined), color: '#dc2626' },
      { label: 'Coverage Rate', value: `${overallPct}%`, color: overallPct >= 80 ? '#16a34a' : '#dc2626' },
    ])}
    ${htmlSection('Coverage Breakdown by Health Center')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Health Center</th>
            <th>Target</th>
            <th>Examined</th>
            <th>Remaining</th>
            <th>Coverage %</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>${tableRows}</tbody>
      </table>
    </div>
    ${htmlSection('Key Observations & Recommendations')}
    <div class="observations-section">
      <div class="observations-title">📊 Analysis & Recommendations</div>
      <div class="observations-content">
        ${obs.map(o => `<div class="observation-item">• ${o}</div>`).join('')}
      </div>
    </div>
    ${htmlFooter()}
  `);

    const filename = `Periodic_Examination_Report_${now.toISOString().slice(0, 10)}.pdf`;
    await html2pdf().set(pdfOptions(filename)).from(html).save();
  } catch (error) {
    console.error('Error generating Periodic Examination PDF:', error);
    throw error;
  }
}

// ─── Vaccination Coverage Report ─────────────────────────────────────────────
export async function exportVaccinationCoveragePdf(
  vaccineDistribution: { name: string; value: number; percentage: number }[],
  monthlyTrend: { month: string; vaccines: number }[],
) {
  try {
    const logoBase64 = await getLogoBase64();
    const now = new Date();
    const totalDoses = vaccineDistribution.reduce((s, v) => s + v.value, 0);
    const avgMonthly = Math.round(monthlyTrend.reduce((s, m) => s + m.vaccines, 0) / monthlyTrend.length);

  const distRows = vaccineDistribution.map(v => `
    <tr>
      <td style="text-align: left; font-weight: 600;">${v.name}</td>
      <td style="font-weight: 700; color: #1e40af;">${v.value}</td>
      <td style="font-weight: 900; font-size: 11px; color: ${v.percentage >= 30 ? '#16a34a' : v.percentage >= 10 ? '#f59e0b' : '#dc2626'};">${v.percentage}%</td>
      <td>
        <span class="status-badge ${v.percentage >= 30 ? 'status-on-track' : v.percentage >= 10 ? 'status-pending' : 'status-attention'}">
          ${v.percentage >= 30 ? '✓ High' : v.percentage >= 10 ? '◐ Moderate' : '⚠ Low'}
        </span>
      </td>
    </tr>`).join('');

  const trendRows = monthlyTrend.map((m, i) => {
    const prev = i > 0 ? monthlyTrend[i - 1].vaccines : null;
    const change = prev !== null ? ((m.vaccines - prev) / prev * 100).toFixed(1) + '%' : '—';
    const changeColor = prev !== null && m.vaccines > prev ? '#16a34a' : prev !== null && m.vaccines < prev ? '#dc2626' : '#64748b';
    const arrow = prev !== null && m.vaccines > prev ? '↗' : prev !== null && m.vaccines < prev ? '↘' : '→';
    return `<tr>
      <td style="font-weight: 600;">${m.month}</td>
      <td style="font-weight: 700; color: #1e40af;">${m.vaccines}</td>
      <td style="color: ${changeColor}; font-weight: 800; font-size: 10px;">${arrow} ${change}</td>
    </tr>`;
  }).join('');

  const html = wrapHtml(`
    ${htmlHeader('Vaccination Coverage Report', 'Employee Immunization Program Statistics', logoBase64)}
    ${htmlMeta([
      { label: 'Report Date', value: now.toLocaleDateString('en-US', { dateStyle: 'long' }) },
      { label: 'Reporting Period', value: `Year ${now.getFullYear()}` },
      { label: 'Vaccine Types Tracked', value: String(vaccineDistribution.length) },
      { label: 'Total Doses', value: String(totalDoses) },
    ])}
    ${htmlKpi([
      { label: 'Total Doses', value: String(totalDoses), color: '#1e40af' },
      { label: 'Vaccine Types', value: String(vaccineDistribution.length), color: '#7c3aed' },
      { label: 'Avg Monthly', value: String(avgMonthly), color: '#16a34a' },
      { label: 'Target Rate', value: '≥ 90%', color: '#0891b2' },
    ])}
    ${htmlSection('Vaccine Distribution by Type')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Vaccine Type</th>
            <th style="text-align:center;">Doses Administered</th>
            <th style="text-align:center;">Coverage Share</th>
            <th style="text-align:center;">Uptake Status</th>
          </tr>
        </thead>
        <tbody>${distRows}</tbody>
        <tfoot>
          <tr>
            <td>Total All Vaccines</td>
            <td style="text-align:center;">${totalDoses}</td>
            <td style="text-align:center;">100%</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
    ${htmlSection('Monthly Vaccination Trend Analysis')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Month</th>
            <th style="text-align:center;">Doses Administered</th>
            <th style="text-align:center;">Change from Previous Month</th>
          </tr>
        </thead>
        <tbody>${trendRows}</tbody>
      </table>
    </div>
    ${htmlFooter()}
  `);

    const filename = `Vaccination_Coverage_Report_${now.toISOString().slice(0, 10)}.pdf`;
    await html2pdf().set(pdfOptions(filename)).from(html).save();
  } catch (error) {
    console.error('Error generating Vaccination Coverage PDF:', error);
    throw error;
  }
}

// ─── Lab Completion Report ────────────────────────────────────────────────────
export async function exportLabCompletionPdf(
  testStatus: { name: string; value: number; percentage: number }[],
  monthlyTrend: { month: string; tests: number }[],
) {
  try {
    const logoBase64 = await getLogoBase64();
    const now = new Date();
    const total     = testStatus.reduce((s, t) => s + t.value, 0);
    const completed = testStatus.find(t => t.name === 'Completed');
    const pending   = testStatus.find(t => t.name === 'Pending');
    const missing   = testStatus.find(t => t.name === 'Missing');

  const statusRows = testStatus.map(s => `
    <tr>
      <td>
        <span class="status-badge ${s.name === 'Completed' ? 'status-completed' : s.name === 'Pending' ? 'status-pending' : 'status-missing'}">
          ${s.name === 'Completed' ? '✓ Completed' : s.name === 'Pending' ? '◐ Pending' : '⚠ Missing'}
        </span>
      </td>
      <td style="font-weight: 700; color: #1e40af;">${s.value}</td>
      <td style="font-weight: 900; font-size: 11px; color: ${s.name === 'Completed' ? '#16a34a' : s.name === 'Pending' ? '#f59e0b' : '#dc2626'};">${s.percentage}%</td>
      <td style="text-align: left; font-size: 9px; color: #64748b;">${s.name === 'Completed' ? 'Archive and document all test results'
            : s.name === 'Pending' ? 'Follow up within 5 business days'
            : 'Immediate scheduling and completion required'}</td>
    </tr>`).join('');

  const trendRows = monthlyTrend.map((m, i) => {
    const prev = i > 0 ? monthlyTrend[i - 1].tests : null;
    const change = prev !== null ? ((m.tests - prev) / prev * 100).toFixed(1) + '%' : '—';
    const changeColor = prev !== null && m.tests > prev ? '#16a34a' : prev !== null && m.tests < prev ? '#dc2626' : '#64748b';
    const arrow = prev !== null && m.tests > prev ? '↗' : prev !== null && m.tests < prev ? '↘' : '→';
    return `<tr>
      <td style="font-weight: 600;">${m.month}</td>
      <td style="font-weight: 700; color: #1e40af;">${m.tests}</td>
      <td style="color: ${changeColor}; font-weight: 800; font-size: 10px;">${arrow} ${change}</td>
    </tr>`;
  }).join('');

  const html = wrapHtml(`
    ${htmlHeader('Laboratory Test Completion Report', 'Occupational Health Lab Testing Status', logoBase64)}
    ${htmlMeta([
      { label: 'Report Date', value: now.toLocaleDateString('en-US', { dateStyle: 'long' }) },
      { label: 'Reporting Period', value: `Year ${now.getFullYear()}` },
      { label: 'Status Categories', value: String(testStatus.length) },
      { label: 'Completion Rate', value: `${completed?.percentage ?? 0}%` },
    ])}
    ${htmlKpi([
      { label: 'Total Tests', value: String(total), color: '#1e40af' },
      { label: 'Completed', value: String(completed?.value ?? 0), color: '#16a34a' },
      { label: 'Pending', value: String(pending?.value ?? 0), color: '#f59e0b' },
      { label: 'Missing', value: String(missing?.value ?? 0), color: '#dc2626' },
    ])}
    ${htmlSection('Test Completion Status Breakdown')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Completion Status</th>
            <th style="text-align:center;">Test Count</th>
            <th style="text-align:center;">Percentage</th>
            <th>Recommended Action</th>
          </tr>
        </thead>
        <tbody>${statusRows}</tbody>
        <tfoot>
          <tr>
            <td>Total All Tests</td>
            <td style="text-align:center;">${total}</td>
            <td style="text-align:center;">100%</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
    ${htmlSection('Monthly Lab Test Volume Trend')}
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Month</th>
            <th style="text-align:center;">Tests Ordered</th>
            <th style="text-align:center;">Change from Previous Month</th>
          </tr>
        </thead>
        <tbody>${trendRows}</tbody>
      </table>
    </div>
    ${htmlFooter()}
  `);

    const filename = `Lab_Completion_Report_${now.toISOString().slice(0, 10)}.pdf`;
    await html2pdf().set(pdfOptions(filename)).from(html).save();
  } catch (error) {
    console.error('Error generating Lab Completion PDF:', error);
    throw error;
  }
}
